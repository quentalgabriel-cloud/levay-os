# ========================================
# Levay OS - Environment Variables Template
# ========================================
# Copie este arquivo para .env e ajuste conforme necessário
# cp .env.example .env

# ========================================
# BANCO DE DADOS
# ========================================
# SQLite (desenvolvimento local - padrão)
DATABASE_URL="file:./prisma/dev.db"

# PostgreSQL (produção - descomente se usar)
# DATABASE_URL="postgresql://user:password@localhost:5432/levay"

# ========================================
# AMBIENTE
# ========================================
NODE_ENV="development"

# ========================================
# API (apps/api)
# ========================================
# Porta do servidor
PORT=3000

# Origens permitidas (CORS) - separadas por vírgula
ALLOWED_ORIGIN="http://localhost:3201"

# Nível de log (debug, info, warn, error)
LOG_LEVEL="info"

# Autenticação (desabilitado para desenvolvimento)
ENABLE_AUTH="false"

# Rate limiting (desabilitado para desenvolvimento)
ENABLE_RATE_LIMIT="false"

# Rate limiting - configurações avançadas
RATE_WINDOW_MS=60000
RATE_MAX_REQUESTS=100

# ========================================
# SUPABASE (opcional)
# ========================================
# For production - Get from Supabase dashboard
# SUPABASE_JWT_SECRET="your-jwt-secret-here"

# ========================================
# FRONTEND (apps/web)
# ========================================
# URL da API
API_BASE_URL="http://localhost:3000"

# Porta do servidor web
PORT_WEB=3201

# ========================================
# WORKERS (apps/workers)
# ========================================
# Porta do workers
PORT_WORKERS=3400

# Intervalo de verificação (em ms)
WORKERS_POLL_INTERVAL_MS=5000

# URL da API para workers
LEVAY_API_BASE_URL="http://localhost:3000"

# ========================================
# INTEGRAÇÕES (opcional)
# ========================================
# N8N Webhook
# N8N_WEBHOOK_URL="https://your-n8n-instance.com/webhook/levay"
# N8N_WEBHOOK_SECRET="your-webhook-secret"

# ========================================
# SOLUÇÃO DE PROBLEMAS
# ========================================
# Para resetar o banco de dados:
# npx prisma db push --force-reset

# Para verificar as variáveis carregadas:
# node -e "console.log(process.env.DATABASE_URL)"